meta {
  name: Register Company and Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "companyName": "Wago Manufacturing Ltd",
    "companyCode": "WGOX01",
    "industry": "Industrial Electronics",
    "firstName": "John",
    "lastName": "Doe",
    "email": "admin@wago.com",
    "password": "Password123!",
    "phone": "+1234567890"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("accessToken", res.body.data.accessToken);
    bru.setEnvVar("refreshToken", res.body.data.refreshToken);
    bru.setEnvVar("userId", res.body.data.user.id);
    bru.setEnvVar("companyId", res.body.data.company.id);
    bru.setEnvVar("sessionId", res.body.data.sessionId);
  }
}
