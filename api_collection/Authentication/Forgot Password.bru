meta {
  name: Forgot Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@apex.com"
  }
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.resetToken) {
    bru.setEnvVar("resetToken", res.body.data.resetToken);
  }
}
